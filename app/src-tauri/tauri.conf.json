{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fantasy World Maker",
  "version": "0.3.0-beta.1",
  "identifier": "dev.worldbuilder.fantasyworldmaker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Fantasy World Maker", "width": 1500, "height": 950, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
